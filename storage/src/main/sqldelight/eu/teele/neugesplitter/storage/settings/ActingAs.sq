-- Which member this installation writes into `by` in each group. It is local to the installation
-- and no event records it (ID-3, format-spec 4.2).
CREATE TABLE IF NOT EXISTS acting_as (
    group_id TEXT NOT NULL PRIMARY KEY,
    member TEXT NOT NULL
);

actAs:
INSERT OR REPLACE INTO acting_as (group_id, member)
VALUES (?, ?);

member:
SELECT member
FROM acting_as
WHERE group_id = ?;

-- Joining fetches a group before anybody is chosen to act as in it.
unclaimed:
SELECT group_id FROM event_row
UNION SELECT group_id FROM log_object
UNION SELECT group_id FROM backend_settings
EXCEPT SELECT group_id FROM acting_as;

forget:
DELETE FROM acting_as
WHERE group_id = ?;

forgetAll:
DELETE FROM acting_as;
