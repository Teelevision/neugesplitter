-- The projection: what the domain's replay made of each group's event log, kept for display
-- (TR-18, TR-18a). Every table here but `projection_state` is derived, may be dropped at any time,
-- and is rebuilt from `event_row` when it is (architecture.md 5).

CREATE TABLE IF NOT EXISTS projection_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    version INTEGER NOT NULL
);

-- Named so only because GROUP is a keyword. `projected_on` is the local date the group's
-- occurrences and balances were derived for (RE-14).
CREATE TABLE IF NOT EXISTS group_row (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    description TEXT,
    emoji TEXT,
    colour TEXT,
    scale INTEGER NOT NULL,
    projected_on TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS member (
    group_id TEXT NOT NULL,
    id TEXT NOT NULL,
    name TEXT NOT NULL,
    removed INTEGER NOT NULL,
    PRIMARY KEY (group_id, id)
);

-- Every entry, deleted ones and occurrences included. Amounts are integers at 10⁻⁸. `author` and
-- `position`, its place in the order entries were created, are null for an occurrence (HI-4).
CREATE TABLE IF NOT EXISTS entry (
    group_id TEXT NOT NULL,
    id TEXT NOT NULL,
    kind TEXT NOT NULL,
    description TEXT NOT NULL,
    date TEXT NOT NULL,
    amount INTEGER NOT NULL,
    note TEXT,
    deleted INTEGER NOT NULL,
    author TEXT,
    position INTEGER,
    edited INTEGER NOT NULL,
    PRIMARY KEY (group_id, id)
);

CREATE INDEX IF NOT EXISTS entry_by_date ON entry (group_id, date);

-- One member of one side of an entry: what was entered for them, and their part of the amount.
CREATE TABLE IF NOT EXISTS side (
    group_id TEXT NOT NULL,
    entry TEXT NOT NULL,
    role TEXT NOT NULL,
    position INTEGER NOT NULL,
    member TEXT NOT NULL,
    scheme TEXT NOT NULL,
    input INTEGER,
    part INTEGER NOT NULL,
    PRIMARY KEY (group_id, entry, role, position)
);

-- Which series and due date an entry is the occurrence of, and whether it is still only offered.
CREATE TABLE IF NOT EXISTS occurrence (
    group_id TEXT NOT NULL,
    series TEXT NOT NULL,
    due TEXT NOT NULL,
    entry TEXT NOT NULL,
    pending INTEGER NOT NULL,
    PRIMARY KEY (group_id, series, due)
);

-- Each member's exact balance, and the one shown and settled at the group's scale (BA-2).
CREATE TABLE IF NOT EXISTS balance (
    group_id TEXT NOT NULL,
    member TEXT NOT NULL,
    exact INTEGER NOT NULL,
    settled INTEGER NOT NULL,
    PRIMARY KEY (group_id, member)
);

version:
SELECT version
FROM projection_state;

setVersion:
INSERT OR REPLACE INTO projection_state (id, version)
VALUES (0, ?);

projectedOn:
SELECT projected_on
FROM group_row
WHERE id = ?;

stale:
SELECT id
FROM group_row
WHERE projected_on != ?;

putGroup:
INSERT OR REPLACE INTO group_row (id, name, description, emoji, colour, scale, projected_on)
VALUES (?, ?, ?, ?, ?, ?, ?);

putMember:
INSERT OR REPLACE INTO member (group_id, id, name, removed)
VALUES (?, ?, ?, ?);

putEntry:
INSERT OR REPLACE INTO entry (group_id, id, kind, description, date, amount, note, deleted, author, position, edited)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

putSide:
INSERT INTO side (group_id, entry, role, position, member, scheme, input, part)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

putOccurrence:
INSERT INTO occurrence (group_id, series, due, entry, pending)
VALUES (?, ?, ?, ?, ?);

putBalance:
INSERT INTO balance (group_id, member, exact, settled)
VALUES (?, ?, ?, ?);

dropEntry {
    DELETE FROM side
    WHERE group_id = :group_id AND entry = :entry;

    DELETE FROM entry
    WHERE group_id = :group_id AND id = :entry;
}

dropOccurrences {
    DELETE FROM side
    WHERE group_id = :group_id
      AND entry IN (SELECT entry FROM occurrence WHERE group_id = :group_id AND series = :series);

    DELETE FROM entry
    WHERE group_id = :group_id
      AND id IN (SELECT entry FROM occurrence WHERE group_id = :group_id AND series = :series);

    DELETE FROM occurrence
    WHERE group_id = :group_id AND series = :series;
}

dropBalances:
DELETE FROM balance
WHERE group_id = ?;

-- The overview's header (ui-design 4): the group, and the settled balance of the member this
-- installation acts as in it (BA-7).
heading:
SELECT
    g.name,
    g.emoji,
    g.colour,
    g.scale,
    b.settled AS own
FROM group_row g
LEFT JOIN acting_as a ON a.group_id = g.id
LEFT JOIN balance b ON b.group_id = g.id AND b.member = a.member
WHERE g.id = ?;

-- The overview's entries, newest first, one row per payer in the order they were entered: every
-- entry that counts, with the part of it that falls to the member this installation acts as, and
-- whether a change to it has not been seen yet (HI-5).
entries:
SELECT
    e.id,
    e.kind,
    e.description,
    e.date,
    e.amount,
    e.edited,
    o.series IS NOT NULL AS repeats,
    b.part AS own,
    m.name AS payer,
    EXISTS (SELECT 1 FROM unseen u WHERE u.group_id = e.group_id AND u.entry = e.id) AS unseen
FROM entry e
JOIN side p ON p.group_id = e.group_id AND p.entry = e.id AND p.role = 'payers'
JOIN member m ON m.group_id = p.group_id AND m.id = p.member
LEFT JOIN occurrence o ON o.group_id = e.group_id AND o.entry = e.id
LEFT JOIN acting_as a ON a.group_id = e.group_id
-- A join rather than a subquery, which SQLDelight would take for never null.
LEFT JOIN side b ON b.group_id = e.group_id AND b.entry = e.id
    AND b.role = 'beneficiaries' AND b.member = a.member
WHERE e.group_id = ? AND e.deleted = 0 AND coalesce(o.pending, 0) = 0
ORDER BY e.date DESC, e.position DESC, e.id DESC, p.position;

-- How many of a group's occurrences are offered and wait for someone to confirm them (RE-10).
pending:
SELECT count(*)
FROM occurrence
WHERE group_id = ? AND pending = 1;

-- The group list (ui-design 3): each group, how many entries it holds that count, the settled
-- balance of the member this installation acts as in it (BA-7), whether it holds changes not seen
-- yet (HI-5) and how its sync stands, if it is shared (SY-6). A group being joined, with nobody
-- chosen to act as yet, is not this installation's yet (BE-6).
listed:
SELECT
    g.id,
    g.name,
    g.emoji,
    g.colour,
    g.scale,
    (SELECT count(*)
     FROM entry e
     WHERE e.group_id = g.id
       AND e.deleted = 0
       AND NOT EXISTS (
           SELECT 1 FROM occurrence o
           WHERE o.group_id = e.group_id AND o.entry = e.id AND o.pending = 1
       )) AS entries,
    b.settled AS own,
    EXISTS (SELECT 1 FROM unseen u WHERE u.group_id = g.id) AS unseen,
    EXISTS (SELECT 1 FROM backend_settings s WHERE s.group_id = g.id) AS shared,
    y.succeeded,
    y.halted_at,
    y.halt,
    y.failure,
    (SELECT count(*)
     FROM event_row r
     WHERE r.group_id = g.id AND r.object_number IS NULL) AS waiting
FROM group_row g
JOIN acting_as a ON a.group_id = g.id
LEFT JOIN balance b ON b.group_id = g.id AND b.member = a.member
LEFT JOIN sync_state y ON y.group_id = g.id
ORDER BY g.name, g.id;

forget {
    DELETE FROM balance WHERE group_id = :group_id;
    DELETE FROM occurrence WHERE group_id = :group_id;
    DELETE FROM side WHERE group_id = :group_id;
    DELETE FROM entry WHERE group_id = :group_id;
    DELETE FROM member WHERE group_id = :group_id;
    DELETE FROM group_row WHERE id = :group_id;
}

forgetAll {
    DELETE FROM balance;
    DELETE FROM occurrence;
    DELETE FROM side;
    DELETE FROM entry;
    DELETE FROM member;
    DELETE FROM group_row;
}
