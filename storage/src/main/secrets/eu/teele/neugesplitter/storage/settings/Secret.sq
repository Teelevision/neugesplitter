-- Each shared group's secrets, sealed with a key the platform keystore never lets out (TR-36): the
-- backend's secret key and an encrypted group's passphrase (TR-25).
CREATE TABLE IF NOT EXISTS secret (
    group_id TEXT NOT NULL,
    kind TEXT NOT NULL,
    sealed BLOB NOT NULL,
    PRIMARY KEY (group_id, kind)
);

keep:
INSERT OR REPLACE INTO secret (group_id, kind, sealed)
VALUES (?, ?, ?);

sealed:
SELECT sealed
FROM secret
WHERE group_id = ? AND kind = ?;

forget:
DELETE FROM secret
WHERE group_id = ?;

forgetAll:
DELETE FROM secret;
